{
  "name": "cookies-utils",
  "version": "0.0.0-development",
  "description": "A JavaScript API for handling cookies",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/cookies-utils.min.js",
  "jsdelivr": "./dist/cookies-utils.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:types && rollup -c",
    "build:types": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --declarationDir dist && node scripts/fix-declaration-specifiers.mjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:browser": "vitest run --project browser",
    "coverage": "vitest run --project unit --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke-package.mjs",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "cookie",
    "cookies",
    "browser",
    "utils",
    "cookies-utils",
    "cookie store",
    "cookiestore",
    "document.cookie",
    "set cookie",
    "get cookie",
    "delete cookie"
  ],
  "author": "Hamza HAMIDI",
  "license": "MIT",
  "homepage": "https://github.com/hamzahamidi/cookies-utils",
  "repository": {
    "type": "git",
    "url": "https://github.com/hamzahamidi/cookies-utils.git"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.2",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "playwright": "^1.62.1",
    "rollup": "^4.62.5",
    "semantic-release": "^24.2.9",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "npm": "^12.0.0",
    "@semantic-release/npm": "^13.1.2"
  }
}
